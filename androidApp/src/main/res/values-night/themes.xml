<?xml version="1.0" encoding="utf-8"?>
<!--
    The system-dark counterpart of values/themes.xml. Two things change, not one: the window
    backdrop moves to MonochromeDark.background (#0A0A0A), and the parent drops "Light" so the
    window chrome Compose does not draw - anything the platform renders on our behalf - also stops
    assuming a light surface.
-->
<resources>
    <style name="Theme.Meotime" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF0A0A0A</item>
    </style>
</resources>
